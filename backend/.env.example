MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=AgriSolution
JSON_BODY_LIMIT=16kb
# Used only when running backend/server.js directly.
# npm start from either folder serves pages and API together on port 3000.
PORT=5000

# Copy to .env and fill real values before running.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# All voice recognition uses your local Whisper worker, not an API key.
LOCAL_SPEECH_URL=http://127.0.0.1:8765

# Optional Plant Disease Detection. Empty dedicated key falls back to GEMINI_API_KEY.
# Gemini account/model access and any required billing must be configured in Google AI Studio.
PLANT_DISEASE_AI_PROVIDER=gemini
PLANT_DISEASE_AI_API_KEY=
PLANT_DISEASE_AI_MODEL=gemini-3.8-flash
# Allowed upload limit: 1–20 MB. Images over 25 million pixels/animations are rejected.
PLANT_DISEASE_MAX_FILE_SIZE_MB=10
# Total analysis deadline (upload, decoding, AI request): 5000–120000 ms.
PLANT_DISEASE_REQUEST_TIMEOUT_MS=60000
